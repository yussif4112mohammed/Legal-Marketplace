# Copy this to .env for local dev, and set these same values as
# Environment Variables in your Koyeb service dashboard for production.

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (Aiven MySQL) ─────────────────────────────
# Get these from your Aiven console → your MySQL service → "Overview" tab.
DB_HOST=your-service-name.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=legal_marketplace
# Aiven requires SSL — leave this as true.
DB_SSL=true
# Optional: path to Aiven's downloaded CA cert for full verification.
# DB_CA_CERT_PATH=/path/to/ca.pem

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string

# ── CORS ────────────────────────────────────────────────
# Your live Vercel frontend URL (no trailing slash).
FRONTEND_URL=https://lexibridge-ten.vercel.app
